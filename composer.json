{
    "name": "pharaonic/laravel-seo",
    "description": "SEO meta tags for Laravel: title, description, Open Graph, Twitter cards and more, set from code, models or Blade directives.",
    "keywords": [
        "php",
        "laravel",
        "seo",
        "meta tags",
        "open graph",
        "twitter cards",
        "blade",
        "pharaonic"
    ],
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Moamen Eltouny (Raggi)",
            "email": "raggigroup@gmail.com"
        }
    ],
    "support": {
        "docs": "https://pharaonic.dev/packages/laravel/seo",
        "issues": "https://github.com/Pharaonic/laravel-seo/issues",
        "source": "https://github.com/Pharaonic/laravel-seo"
    },
    "require": {
        "php": ">=8.0 <8.1",
        "illuminate/container": "^7.30",
        "illuminate/contracts": "^7.30",
        "illuminate/database": "^7.30",
        "illuminate/support": "^7.30",
        "illuminate/view": "^7.30"
    },
    "require-dev": {
        "laravel/pint": "^1.5",
        "orchestra/testbench": "^5.20",
        "pestphp/pest": "^1.23",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^9.6.33"
    },
    "autoload": {
        "psr-4": {
            "Pharaonic\\Laravel\\SEO\\": "src/"
        },
        "files": [
            "src/helper.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Pharaonic\\Laravel\\SEO\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Pharaonic\\Laravel\\SEO\\SEOServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "@php vendor/bin/pest",
        "analyse": "@php vendor/bin/phpstan analyse --memory-limit=1G",
        "format": "@php vendor/bin/pint",
        "format:check": "@php vendor/bin/pint --test",
        "security": "@composer audit",
        "check": [
            "@composer validate --strict",
            "@format:check",
            "@analyse",
            "@test",
            "@security"
        ]
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        },
        "audit": {
            "abandoned": "report"
        },
        "policy": {
            "advisories": {
                "block": false,
                "ignore": {
                    "laravel/framework": "No fixed release within Laravel 7; the application chooses the framework release.",
                    "league/commonmark": "No fixed release within Laravel 7; the application chooses the framework release.",
                    "league/flysystem": "No fixed release within Laravel 7; the application chooses the framework release."
                }
            }
        },
        "sort-packages": true
    },
    "prefer-stable": true
}
